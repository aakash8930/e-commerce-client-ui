# runtime data (memory DB, indexes, reports) — keep out of git
data/*
!data/.gitkeep
!data/indexes/.gitkeep
!data/reports/.gitkeep

# logs
logs/*
!logs/.gitkeep

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# secrets — never commit
.env
*.pem
*.key
id_rsa*
id_ed25519*

# editor / OS
.DS_Store
.idea/
.vscode/
